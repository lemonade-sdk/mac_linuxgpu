+
+/* ---- mac_linuxgpu ---- */
+
+/* Metal surfaces of a DRM driver on mac_linuxgpu, presented by the GPU's
+ * own display engine (wsi_common_mlg.h).
+ *
+ * The driver mirrors the macOS desktop to a monitor on the GPU (its display
+ * output) and is the only one that commits to it. A swapchain here attaches
+ * to that output (MLG_WSI_OUTPUT names its connector, or "auto") and hands
+ * it each presented image, a framebuffer of the GPU's primary node, through
+ * drmMlgScanout:
+ *
+ *  - the primary plane, in place of the desktop, when the layer's window
+ *    fills its screen, or when the window is not on the monitor's screen
+ *    (the monitor then shows the game whatever macOS does with the window);
+ *  - an overlay plane over the desktop at the window's rectangle when the
+ *    window is a window on the monitor's screen.
+ *
+ * MLG_WSI_MODE=fullscreen or windowed chooses instead of the window. No
+ * pixel is copied: the images are tiled, compressed where the display
+ * engine reads compression, and stay in the GPU's memory. The rendering
+ * waits are the images' implicit fences, which the driver's commit waits
+ * for; each present's syncobj signals at the vblank that shows it.
+ *
+ * Presenting without MLG_WSI_OUTPUT is not supported: the surface reports
+ * no presentation support and creating a swapchain fails. Every failure is
+ * reported on stderr with the step that failed and the driver's errno, and
+ * nothing is presented any other way. */
+#ifdef LIBDRM_MLG_SCANOUT
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <xf86drmMode.h>
+
+#include "drm-uapi/drm_fourcc.h"
+#include "util/macros.h"
+#include "util/simple_mtx.h"
+#include "util/u_atomic.h"
+#include "c11/threads.h"
+
+#define MLG_FLIP_TIMEOUT_MS 2000
+
+static void
+mlg_error(const char *fmt, ...) PRINTFLIKE(1, 2);
+
+static void
+mlg_error(const char *fmt, ...)
+{
+   va_list ap;
+
+   va_start(ap, fmt);
+   fputs("mlg-wsi: ", stderr);
+   vfprintf(stderr, fmt, ap);
+   fputc('\n', stderr);
+   va_end(ap);
+}
+
+static const char *
+mlg_output_env(void)
+{
+   const char *output = getenv("MLG_WSI_OUTPUT");
+
+   return output && output[0] ? output : NULL;
+}
+
+static bool
+wsi_mlg_device(const struct wsi_device *wsi_device)
+{
+   return !wsi_device->sw && !wsi_device->metal.bind_drawable_to_vkimage;
+}
+
+/* ---- the attachment, one per process ---- */
+
+static simple_mtx_t attach_lock = SIMPLE_MTX_INITIALIZER;
+static unsigned attach_count;
+
+static int64_t
+deadline_ns(uint64_t from_now_ns)
+{
+   struct timespec ts;
+
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   uint64_t now = (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+   return from_now_ns > (uint64_t)INT64_MAX - now ? INT64_MAX : (int64_t)(now + from_now_ns);
+}
+
+static struct mlg_lx_scanout
+mlg_request(uint32_t op)
+{
+   return (struct mlg_lx_scanout){ .version = MLG_LX_SCANOUT_VERSION, .op = op };
+}
+
+/* ---- surface queries ---- */
+
+static VkResult
+wsi_mlg_surface_get_support(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                            uint32_t queueFamilyIndex, VkBool32 *pSupported)
+{
+   static int warned;
+
+   *pSupported = mlg_output_env() != NULL;
+   if (!*pSupported && !p_atomic_xchg(&warned, 1))
+      mlg_error("presenting needs MLG_WSI_OUTPUT: the connector of the GPU's display output "
+                "(\"DP-1\"), or \"auto\" (see mlg-run)");
+   return VK_SUCCESS;
+}
+
+static const VkFormat mlg_formats[] = {
+   VK_FORMAT_B8G8R8A8_UNORM,
+   VK_FORMAT_B8G8R8A8_SRGB,
+};
+
+static VkResult
+wsi_mlg_surface_get_capabilities(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                                 VkSurfaceCapabilities2KHR *caps)
+{
+   VkIcdSurfaceMetal *metal_surface = (VkIcdSurfaceMetal *)surface;
+   VkSurfaceCapabilitiesKHR *c = &caps->surfaceCapabilities;
+
+   wsi_metal_layer_size(metal_surface->pLayer, &c->currentExtent.width,
+                        &c->currentExtent.height);
+   if (!c->currentExtent.width || !c->currentExtent.height)
+      c->currentExtent.width = c->currentExtent.height = UINT32_MAX;
+   /* One on screen, one waiting for its vblank, one being drawn. */
+   c->minImageCount = 3;
+   c->maxImageCount = 8;
+   c->minImageExtent = (VkExtent2D){ 1, 1 };
+   c->maxImageExtent = (VkExtent2D){ wsi_device->maxImageDimension2D,
+                                     wsi_device->maxImageDimension2D };
+   c->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   c->currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   c->maxImageArrayLayers = 1;
+   c->supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+
+   VkImageUsageFlags usage = wsi_caps_get_image_usage();
+   VkImageUsageFlags2CreateInfoKHR *usage2 =
+      vk_find_struct(caps->pNext, IMAGE_USAGE_FLAGS_2_CREATE_INFO_KHR);
+   if (usage2)
+      usage2->usage = usage;
+   else
+      c->supportedUsageFlags = usage;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_mlg_surface_get_formats(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                            uint32_t *pSurfaceFormatCount, VkSurfaceFormatKHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(mlg_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormatKHR, &out, f) {
+         f->format = mlg_formats[i];
+         f->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_mlg_surface_get_formats2(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                             const void *info_next, uint32_t *pSurfaceFormatCount,
+                             VkSurfaceFormat2KHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(mlg_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, f) {
+         f->surfaceFormat.format = mlg_formats[i];
+         f->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_mlg_surface_get_present_modes(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                                  uint32_t *pPresentModeCount, VkPresentModeKHR *pPresentModes)
+{
+   /* Every frame is shown, one per vblank. */
+   if (!pPresentModes) {
+      *pPresentModeCount = 1;
+      return VK_SUCCESS;
+   }
+   if (*pPresentModeCount < 1)
+      return VK_INCOMPLETE;
+   pPresentModes[0] = VK_PRESENT_MODE_FIFO_KHR;
+   *pPresentModeCount = 1;
+   return VK_SUCCESS;
+}
+
+/* ---- the swapchain ---- */
+
+enum mlg_image_state {
+   MLG_IMAGE_IDLE,
+   MLG_IMAGE_DRAWING,
+   MLG_IMAGE_QUEUED,   /* handed to the output, its vblank not seen yet */
+   MLG_IMAGE_SHOWN,    /* on screen */
+};
+
+struct wsi_mlg_image {
+   struct wsi_image base;
+   uint32_t handle;    /* the buffer in the primary file */
+   uint32_t fb_id;
+   uint32_t syncobj;   /* signals at the vblank that shows the image */
+   enum mlg_image_state state;
+   uint64_t serial;    /* order of presents */
+   uint64_t present_id;
+};
+
+enum mlg_mode {
+   MLG_MODE_AUTO,
+   MLG_MODE_FULLSCREEN,
+   MLG_MODE_WINDOWED,
+};
+
+struct wsi_mlg_swapchain {
+   struct wsi_swapchain base;
+   VkIcdSurfaceMetal *surface;
+   VkExtent2D extent;
+   int card;                           /* the primary node */
+   struct mlg_lx_scanout_state output; /* at attach */
+   uint32_t display_id;                /* the macOS display of the monitor, 0: none */
+   enum mlg_mode mode;
+   struct wsi_mlg_window_cache *window;
+   mtx_t lock;
+   VkResult status;
+   uint64_t serial;
+   uint64_t shown_present_id;          /* the newest present id on screen */
+   /* The last frame's placement (checked by the driver when it changes),
+    * and whether the window is off the monitor (nothing of ours on it). */
+   struct drm_mlg_placement last;
+   bool hidden;
+   struct wsi_mlg_image images[0];
+};
+VK_DEFINE_NONDISP_HANDLE_CASTS(wsi_mlg_swapchain, base.base, VkSwapchainKHR,
+                               VK_OBJECT_TYPE_SWAPCHAIN_KHR)
+
+static const char *
+layer_name(uint32_t layer)
+{
+   return layer == MLG_LX_LAYER_PRIMARY ? "the primary plane" : "an overlay plane";
+}
+
+/* The primary node of the GPU this device is. */
+static int
+mlg_open_primary(const struct wsi_device *wsi_device)
+{
+   drmDevicePtr devices[8];
+   int count = drmGetDevices2(0, devices, ARRAY_SIZE(devices));
+   int fd = -1;
+
+   for (int i = 0; i < count; i++) {
+      drmDevicePtr d = devices[i];
+      const VkPhysicalDevicePCIBusInfoPropertiesEXT *bus = &wsi_device->pci_bus_info;
+
+      if (fd >= 0 || d->bustype != DRM_BUS_PCI || !(d->available_nodes & (1 << DRM_NODE_PRIMARY)))
+         continue;
+      if (d->businfo.pci->domain != bus->pciDomain || d->businfo.pci->bus != bus->pciBus ||
+          d->businfo.pci->dev != bus->pciDevice || d->businfo.pci->func != bus->pciFunction)
+         continue;
+      fd = drmFileOpen(d->nodes[DRM_NODE_PRIMARY], O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+         mlg_error("opening %s failed: %s", d->nodes[DRM_NODE_PRIMARY], strerror(errno));
+   }
+   if (count > 0)
+      drmFreeDevices(devices, count);
+   if (fd < 0 && count >= 0)
+      mlg_error("no primary node for the GPU at %04x:%02x:%02x.%x",
+                wsi_device->pci_bus_info.pciDomain, wsi_device->pci_bus_info.pciBus,
+                wsi_device->pci_bus_info.pciDevice, wsi_device->pci_bus_info.pciFunction);
+   return fd;
+}
+
+/* The XRGB8888 modifiers of plane @plane_id's IN_FORMATS, appended to @mods
+ * (an array of @cap), or only those already in it when @intersect. */
+static uint32_t
+mlg_plane_modifiers(int card, uint32_t plane_id, uint64_t *mods, uint32_t count, uint32_t cap,
+                    bool intersect)
+{
+   drmModeObjectPropertiesPtr props = drmModeObjectGetProperties(card, plane_id,
+                                                                 DRM_MODE_OBJECT_PLANE);
+   uint64_t blob_id = 0;
+
+   if (!props)
+      return intersect ? 0 : count;
+   for (uint32_t i = 0; i < props->count_props && !blob_id; i++) {
+      drmModePropertyPtr p = drmModeGetProperty(card, props->props[i]);
+      if (p && !strcmp(p->name, "IN_FORMATS"))
+         blob_id = props->prop_values[i];
+      drmModeFreeProperty(p);
+   }
+   drmModeFreeObjectProperties(props);
+   drmModePropertyBlobPtr blob = blob_id ? drmModeGetPropertyBlob(card, (uint32_t)blob_id) : NULL;
+   if (!blob)
+      return intersect ? 0 : count;
+
+   uint64_t found[64];
+   uint32_t nfound = 0;
+   drmModeFormatModifierIterator it = { 0 };
+   while (drmModeFormatModifierBlobIterNext(blob, &it))
+      if (it.fmt == DRM_FORMAT_XRGB8888 && nfound < ARRAY_SIZE(found))
+         found[nfound++] = it.mod;
+   drmModeFreePropertyBlob(blob);
+
+   if (!intersect) {
+      for (uint32_t i = 0; i < nfound && count < cap; i++)
+         mods[count++] = found[i];
+      return count;
+   }
+   uint32_t kept = 0;
+   for (uint32_t i = 0; i < count; i++)
+      for (uint32_t j = 0; j < nfound; j++)
+         if (mods[i] == found[j]) {
+            mods[kept++] = mods[i];
+            break;
+         }
+   return kept;
+}
+
+/* Where the next frame goes (drmMlgPlaceWindow): the window's content and
+ * the monitor's screen in global points, the output's mode, the image. 0, or
+ * -EINVAL with the reason in out->why. */
+static int
+mlg_placement(struct wsi_mlg_swapchain *chain, struct drm_mlg_placement *out)
+{
+   struct drm_mlg_place_in in = {
+      .mode = chain->mode == MLG_MODE_FULLSCREEN ? DRM_MLG_PLACE_FULLSCREEN :
+              chain->mode == MLG_MODE_WINDOWED ? DRM_MLG_PLACE_WINDOWED : DRM_MLG_PLACE_AUTO,
+      .crtc_w = chain->output.width,
+      .crtc_h = chain->output.height,
+      .image_w = chain->extent.width,
+      .image_h = chain->extent.height,
+   };
+   struct wsi_mlg_window win;
+
+   wsi_mlg_window_get(chain->window, &win);
+   in.have_screen = chain->display_id &&
+                    wsi_mlg_display_bounds(chain->display_id, &in.screen_x, &in.screen_y,
+                                           &in.screen_w, &in.screen_h);
+   in.have_window = win.has_window;
+   /* Native full screen counts on the monitor's screen only. */
+   in.window_native_fullscreen = win.native_fullscreen && win.display_id == chain->display_id;
+   in.win_x = win.x;
+   in.win_y = win.y;
+   in.win_w = win.width;
+   in.win_h = win.height;
+   return drmMlgPlaceWindow(&in, out);
+}
+
+static bool
+mlg_same_placement(const struct drm_mlg_placement *a, const struct drm_mlg_placement *b)
+{
+   return a->layer == b->layer && a->src_x == b->src_x && a->src_y == b->src_y &&
+          a->src_w == b->src_w && a->src_h == b->src_h && a->dst_x == b->dst_x &&
+          a->dst_y == b->dst_y && a->dst_w == b->dst_w && a->dst_h == b->dst_h;
+}
+
+static int
+mlg_scanout_image(struct wsi_mlg_swapchain *chain, uint32_t op, struct wsi_mlg_image *image,
+                  const struct drm_mlg_placement *p, struct mlg_lx_scanout_state *st)
+{
+   struct mlg_lx_scanout req = mlg_request(op);
+
+   req.fd = chain->card;
+   req.layer = p->layer;
+   req.fb_id = image->fb_id;
+   req.syncobj = image->syncobj;
+   req.src_x = p->src_x;
+   req.src_y = p->src_y;
+   req.src_w = p->src_w;
+   req.src_h = p->src_h;
+   req.dst_x = p->dst_x;
+   req.dst_y = p->dst_y;
+   req.dst_w = p->dst_w;
+   req.dst_h = p->dst_h;
+   return drmMlgScanout(&req, st);
+}
+
+/* A driver check that failed, with what it was asked. */
+static void
+mlg_report_refusal(struct wsi_mlg_swapchain *chain, const char *what, const struct drm_mlg_placement *p,
+                   int r)
+{
+   mlg_error("%s on %s refused (%s): %s, image %u,%u %ux%u to %d,%d %ux%u "
+             "(scale %.3f x %.3f)", what, chain->output.connector, layer_name(p->layer),
+             strerror(-r), p->src_x, p->src_y, p->src_w, p->src_h, p->dst_x, p->dst_y, p->dst_w,
+             p->dst_h, p->src_w ? (double)p->dst_w / p->src_w : 0.0,
+             p->src_h ? (double)p->dst_h / p->src_h : 0.0);
+}
+
+static VkResult
+mlg_surface_lost(struct wsi_mlg_swapchain *chain)
+{
+   chain->status = VK_ERROR_SURFACE_LOST_KHR;
+   return chain->status;
+}
+
+/* Wait (until @deadline, absolute CLOCK_MONOTONIC) for @image's vblank.
+ * 0, -ETIME, or another -errno. */
+static int
+mlg_wait_flip(struct wsi_mlg_swapchain *chain, struct wsi_mlg_image *image, int64_t deadline)
+{
+   uint32_t sync = image->syncobj;
+   int r = drmSyncobjWait(chain->card, &sync, 1, deadline,
+                          DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL);
+   return r ? (r < 0 ? r : -errno) : 0;
+}
+
+/* @image reached the screen: the one before it leaves it. */
+static void
+mlg_shown(struct wsi_mlg_swapchain *chain, struct wsi_mlg_image *image)
+{
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_mlg_image *other = &chain->images[i];
+      if (other != image && other->state == MLG_IMAGE_SHOWN && other->serial < image->serial)
+         other->state = MLG_IMAGE_IDLE;
+   }
+   image->state = MLG_IMAGE_SHOWN;
+   if (image->present_id > chain->shown_present_id)
+      chain->shown_present_id = image->present_id;
+}
+
+static struct wsi_mlg_image *
+mlg_oldest_queued(struct wsi_mlg_swapchain *chain)
+{
+   struct wsi_mlg_image *oldest = NULL;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_mlg_image *image = &chain->images[i];
+      if (image->state == MLG_IMAGE_QUEUED && (!oldest || image->serial < oldest->serial))
+         oldest = image;
+   }
+   return oldest;
+}
+
+/* Account every queued image whose vblank passed, oldest first. */
+static VkResult
+mlg_poll_flips(struct wsi_mlg_swapchain *chain)
+{
+   struct wsi_mlg_image *image;
+
+   while ((image = mlg_oldest_queued(chain))) {
+      int r = mlg_wait_flip(chain, image, 0);
+      if (r == -ETIME)
+         return VK_SUCCESS;
+      if (r) {
+         mlg_error("waiting for a frame's vblank on %s failed: %s", chain->output.connector,
+                   strerror(-r));
+         return mlg_surface_lost(chain);
+      }
+      mlg_shown(chain, image);
+   }
+   return VK_SUCCESS;
+}
+
+/* Wait for the oldest queued image's vblank until @deadline. */
+static VkResult
+mlg_wait_oldest(struct wsi_mlg_swapchain *chain, int64_t deadline, bool *timed_out)
+{
+   struct wsi_mlg_image *image = mlg_oldest_queued(chain);
+
+   *timed_out = false;
+   if (!image)
+      return VK_SUCCESS;
+   int r = mlg_wait_flip(chain, image, deadline);
+   if (r == -ETIME) {
+      *timed_out = true;
+      return VK_SUCCESS;
+   }
+   if (r) {
+      mlg_error("waiting for a frame's vblank on %s failed: %s", chain->output.connector,
+                strerror(-r));
+      return mlg_surface_lost(chain);
+   }
+   mlg_shown(chain, image);
+   return VK_SUCCESS;
+}
+
+static struct wsi_image *
+wsi_mlg_get_wsi_image(struct wsi_swapchain *wsi_chain, uint32_t image_index)
+{
+   struct wsi_mlg_swapchain *chain = (struct wsi_mlg_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static VkResult
+wsi_mlg_acquire_next_image(struct wsi_swapchain *wsi_chain, const VkAcquireNextImageInfoKHR *info,
+                           uint32_t *image_index)
+{
+   struct wsi_mlg_swapchain *chain = (struct wsi_mlg_swapchain *)wsi_chain;
+   const int64_t deadline = info->timeout == UINT64_MAX ? INT64_MAX : deadline_ns(info->timeout);
+   VkResult result;
+
+   mtx_lock(&chain->lock);
+   for (;;) {
+      result = chain->status;
+      if (result == VK_SUCCESS)
+         result = mlg_poll_flips(chain);
+      if (result != VK_SUCCESS)
+         break;
+      for (uint32_t i = 0; i < chain->base.image_count; i++) {
+         if (chain->images[i].state == MLG_IMAGE_IDLE) {
+            chain->images[i].state = MLG_IMAGE_DRAWING;
+            *image_index = i;
+            mtx_unlock(&chain->lock);
+            return VK_SUCCESS;
+         }
+      }
+      bool timed_out;
+      if (!mlg_oldest_queued(chain)) {
+         /* Every image is drawn or on screen: none frees up by itself. */
+         result = info->timeout ? VK_TIMEOUT : VK_NOT_READY;
+         break;
+      }
+      result = mlg_wait_oldest(chain, deadline, &timed_out);
+      if (result != VK_SUCCESS)
+         break;
+      if (timed_out) {
+         result = info->timeout ? VK_TIMEOUT : VK_NOT_READY;
+         break;
+      }
+   }
+   mtx_unlock(&chain->lock);
+   return result;
+}
+
+static VkResult
+wsi_mlg_release_images(struct wsi_swapchain *wsi_chain, uint32_t count, const uint32_t *indices)
+{
+   struct wsi_mlg_swapchain *chain = (struct wsi_mlg_swapchain *)wsi_chain;
+
+   mtx_lock(&chain->lock);
+   for (uint32_t i = 0; i < count; i++) {
+      assert(indices[i] < chain->base.image_count);
+      chain->images[indices[i]].state = MLG_IMAGE_IDLE;
+   }
+   mtx_unlock(&chain->lock);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_mlg_queue_present(struct wsi_swapchain *wsi_chain, uint32_t image_index, uint64_t present_id,
+                      const VkPresentRegionKHR *damage)
+{
+   struct wsi_mlg_swapchain *chain = (struct wsi_mlg_swapchain *)wsi_chain;
+   struct wsi_mlg_image *image = &chain->images[image_index];
+   struct mlg_lx_scanout_state st;
+   struct drm_mlg_placement place;
+   VkResult result;
+   int r;
+
+   mtx_lock(&chain->lock);
+   result = chain->status;
+   if (result != VK_SUCCESS)
+      goto out;
+   /* The output takes one frame ahead of the one waiting for its vblank:
+    * the frame before this one goes to the screen first (every frame is
+    * shown, at most one per vblank). */
+   while (mlg_oldest_queued(chain)) {
+      bool timed_out;
+      result = mlg_wait_oldest(chain, deadline_ns(MLG_FLIP_TIMEOUT_MS * 1000000ull), &timed_out);
+      if (result != VK_SUCCESS)
+         goto out;
+      if (timed_out) {
+         mlg_error("a frame on %s did not reach the screen in %u ms", chain->output.connector,
+                   MLG_FLIP_TIMEOUT_MS);
+         result = mlg_surface_lost(chain);
+         goto out;
+      }
+   }
+
+   r = mlg_placement(chain, &place);
+   if (r) {
+      mlg_error("placing a frame on %s: %s", chain->output.connector, place.why);
+      result = mlg_surface_lost(chain);
+      goto out;
+   }
+
+   if (!place.layer) {
+      /* The window is off the monitor: the desktop shows there, the game
+       * goes on, and its frames wait one refresh each (FIFO pacing). */
+      if (!chain->hidden) {
+         struct mlg_lx_scanout req = mlg_request(MLG_LX_SCANOUT_HIDE);
+
+         r = drmMlgScanout(&req, &st);
+         if (r) {
+            mlg_error("taking the frames off %s failed: %s", chain->output.connector,
+                      strerror(-r));
+            result = mlg_surface_lost(chain);
+            goto out;
+         }
+         for (uint32_t i = 0; i < chain->base.image_count; i++)
+            if (chain->images[i].state == MLG_IMAGE_SHOWN)
+               chain->images[i].state = MLG_IMAGE_IDLE;
+         fprintf(stderr, "mlg-wsi: %s: %s; the desktop shows there until the window "
+                 "comes back\n", chain->output.connector, place.why);
+         chain->hidden = true;
+      }
+      image->state = MLG_IMAGE_IDLE;
+      if (present_id > chain->shown_present_id)
+         chain->shown_present_id = present_id;
+      chain->last = place;
+      mtx_unlock(&chain->lock);
+      if (chain->output.refresh_mhz)
+         usleep((useconds_t)(1000000000ull / chain->output.refresh_mhz));
+      return result;
+   }
+   if (chain->hidden) {
+      fprintf(stderr, "mlg-wsi: %s: the window is back\n", chain->output.connector);
+      chain->hidden = false;
+   }
+   /* A new place is checked by the driver first: a refusal names it. */
+   if (!mlg_same_placement(&place, &chain->last)) {
+      r = mlg_scanout_image(chain, MLG_LX_SCANOUT_TEST, image, &place, &st);
+      if (r) {
+         mlg_report_refusal(chain, "a frame's place", &place, r);
+         result = mlg_surface_lost(chain);
+         goto out;
+      }
+   }
+   r = mlg_scanout_image(chain, MLG_LX_SCANOUT_PRESENT, image, &place, &st);
+   if (r) {
+      mlg_error("present on %s (%s at %d,%d %ux%u) failed: %s%s%s", chain->output.connector,
+                layer_name(place.layer), place.dst_x, place.dst_y, place.dst_w, place.dst_h,
+                strerror(-r), st.error ? "; the display output stopped with " : "",
+                st.error ? strerror(-st.error) : "");
+      result = mlg_surface_lost(chain);
+      goto out;
+   }
+   if (place.layer != chain->last.layer || getenv("MLG_WSI_DEBUG"))
+      fprintf(stderr, "mlg-wsi: %s: %ux%u frames on %s at %d,%d %ux%u (image %u,%u %ux%u)\n",
+              chain->output.connector, chain->extent.width, chain->extent.height,
+              layer_name(place.layer), place.dst_x, place.dst_y, place.dst_w, place.dst_h,
+              place.src_x, place.src_y, place.src_w, place.src_h);
+   chain->last = place;
+   {
+      /* The layer at another size than the images: the application
+       * makes new ones (a window resized, full screen toggled). */
+      uint32_t lw = 0, lh = 0;
+
+      wsi_metal_layer_size(chain->surface->pLayer, &lw, &lh);
+      if (lw && lh && (lw != chain->extent.width || lh != chain->extent.height))
+         result = VK_SUBOPTIMAL_KHR;
+   }
+   image->state = MLG_IMAGE_QUEUED;
+   image->serial = ++chain->serial;
+   image->present_id = present_id;
+out:
+   mtx_unlock(&chain->lock);
+   return result;
+}
+
+static VkResult
+wsi_mlg_wait_for_present(struct wsi_swapchain *wsi_chain, uint64_t present_id, uint64_t timeout)
+{
+   struct wsi_mlg_swapchain *chain = (struct wsi_mlg_swapchain *)wsi_chain;
+   const int64_t deadline = timeout == UINT64_MAX ? INT64_MAX : deadline_ns(timeout);
+   VkResult result;
+
+   mtx_lock(&chain->lock);
+   for (;;) {
+      result = chain->status;
+      if (result == VK_SUCCESS)
+         result = mlg_poll_flips(chain);
+      if (result != VK_SUCCESS || chain->shown_present_id >= present_id)
+         break;
+      bool timed_out;
+      if (!mlg_oldest_queued(chain)) {
+         result = VK_TIMEOUT;   /* that present was never made */
+         break;
+      }
+      result = mlg_wait_oldest(chain, deadline, &timed_out);
+      if (result != VK_SUCCESS)
+         break;
+      if (timed_out) {
+         result = VK_TIMEOUT;
+         break;
+      }
+   }
+   mtx_unlock(&chain->lock);
+   return result;
+}
+
+static void
+mlg_image_finish(struct wsi_mlg_swapchain *chain, struct wsi_mlg_image *image)
+{
+   /* CLOSEFB, not RMFB: a framebuffer still on screen stays there until
+    * the output replaces it, rather than the plane being turned off. */
+   if (image->fb_id)
+      drmModeCloseFB(chain->card, image->fb_id);
+   if (image->handle)
+      drmCloseBufferHandle(chain->card, image->handle);
+   if (image->syncobj)
+      drmSyncobjDestroy(chain->card, image->syncobj);
+   wsi_destroy_image(&chain->base, &image->base);
+}
+
+static void
+mlg_detach(struct wsi_mlg_swapchain *chain)
+{
+   simple_mtx_lock(&attach_lock);
+   if (attach_count && !--attach_count) {
+      struct mlg_lx_scanout req = mlg_request(MLG_LX_SCANOUT_DETACH);
+      struct mlg_lx_scanout_state st;
+      int r = drmMlgScanout(&req, &st);
+      if (r)
+         mlg_error("giving %s back to the desktop failed: %s", chain->output.connector,
+                   strerror(-r));
+   }
+   simple_mtx_unlock(&attach_lock);
+}
+
+static VkResult
+wsi_mlg_swapchain_destroy(struct wsi_swapchain *wsi_chain, const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_mlg_swapchain *chain = (struct wsi_mlg_swapchain *)wsi_chain;
+
+   /* The desktop goes back on screen first (when this is the process's
+    * last swapchain), so no image of ours is scanned out as it goes. */
+   mlg_detach(chain);
+   for (uint32_t i = 0; i < chain->base.image_count; i++)
+      mlg_image_finish(chain, &chain->images[i]);
+   wsi_mlg_window_cache_destroy(chain->window);
+   close(chain->card);
+   mtx_destroy(&chain->lock);
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+   return VK_SUCCESS;
+}
+
+static VkResult
+mlg_image_init(struct wsi_mlg_swapchain *chain, struct wsi_mlg_image *image)
+{
+   VkResult result = wsi_create_image(&chain->base, &chain->base.image_info, &image->base);
+   if (result != VK_SUCCESS)
+      return result;
+
+   uint32_t handles[4] = { 0 };
+   uint64_t modifiers[4] = { 0 };
+   int r = drmPrimeFDToHandle(chain->card, image->base.dma_buf_fd, &image->handle);
+   if (r) {
+      mlg_error("importing a swapchain image on the primary node failed: %s", strerror(errno));
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   for (int p = 0; p < image->base.num_planes; p++) {
+      handles[p] = image->handle;
+      modifiers[p] = image->base.drm_modifier;
+   }
+   r = drmModeAddFB2WithModifiers(chain->card, chain->extent.width, chain->extent.height,
+                                  DRM_FORMAT_XRGB8888, handles, image->base.row_pitches,
+                                  image->base.offsets,
+                                  image->base.drm_modifier != DRM_FORMAT_MOD_INVALID ? modifiers : NULL,
+                                  &image->fb_id,
+                                  image->base.drm_modifier != DRM_FORMAT_MOD_INVALID ?
+                                  DRM_MODE_FB_MODIFIERS : 0);
+   if (r) {
+      mlg_error("a %ux%u framebuffer with modifier 0x%llx failed: %s", chain->extent.width,
+                chain->extent.height, (unsigned long long)image->base.drm_modifier, strerror(-r));
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   if (drmSyncobjCreate(chain->card, 0, &image->syncobj)) {
+      mlg_error("a syncobj for a swapchain image failed: %s", strerror(errno));
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   image->state = MLG_IMAGE_IDLE;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_mlg_surface_create_swapchain(VkIcdSurfaceBase *icd_surface, VkDevice device,
+                                 struct wsi_device *wsi_device,
+                                 const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                 const VkAllocationCallbacks *pAllocator,
+                                 struct wsi_swapchain **swapchain_out)
+{
+   VkIcdSurfaceMetal *surface = (VkIcdSurfaceMetal *)icd_surface;
+   const char *output = mlg_output_env();
+   const char *mode = getenv("MLG_WSI_MODE");
+   struct mlg_lx_scanout_state st;
+   struct mlg_lx_scanout req;
+   VkResult result = VK_ERROR_INITIALIZATION_FAILED;
+   uint64_t mods[64];
+   uint32_t nmods = 0;
+   bool attached = false;
+   int r;
+
+   if (!output) {
+      mlg_error("presenting needs MLG_WSI_OUTPUT (see mlg-run)");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   if (pCreateInfo->imageFormat != VK_FORMAT_B8G8R8A8_UNORM &&
+       pCreateInfo->imageFormat != VK_FORMAT_B8G8R8A8_SRGB) {
+      mlg_error("format %d is not a format the surface reported", pCreateInfo->imageFormat);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   const unsigned num_images = MAX2(pCreateInfo->minImageCount, 3);
+   struct wsi_mlg_swapchain *chain =
+      vk_zalloc(pAllocator, sizeof(*chain) + num_images * sizeof(chain->images[0]), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (!chain)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   chain->card = -1;
+   chain->surface = surface;
+   chain->extent = pCreateInfo->imageExtent;
+   chain->mode = mode && !strcmp(mode, "fullscreen") ? MLG_MODE_FULLSCREEN :
+                 mode && !strcmp(mode, "windowed") ? MLG_MODE_WINDOWED : MLG_MODE_AUTO;
+   if (mode && chain->mode == MLG_MODE_AUTO && strcmp(mode, "auto")) {
+      mlg_error("MLG_WSI_MODE=%s: not fullscreen, windowed or auto", mode);
+      goto fail_free;
+   }
+   if (mtx_init(&chain->lock, mtx_plain) != thrd_success) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_free;
+   }
+
+   chain->card = mlg_open_primary(wsi_device);
+   if (chain->card < 0)
+      goto fail_lock;
+
+   /* Attach to the output on that connector. */
+   req = mlg_request(MLG_LX_SCANOUT_ATTACH);
+   if (strcmp(output, "auto"))
+      snprintf(req.connector, sizeof(req.connector), "%s", output);
+   simple_mtx_lock(&attach_lock);
+   r = drmMlgScanout(&req, &st);
+   if (!r)
+      attach_count++;
+   simple_mtx_unlock(&attach_lock);
+   if (r) {
+      if (r == -ENOENT && st.output)
+         mlg_error("MLG_WSI_OUTPUT=%s: the display output drives %s", output, st.connector);
+      else if (r == -ENOENT)
+         mlg_error("MLG_WSI_OUTPUT=%s: the driver has no display output; the display agent "
+                   "lights one (MacLinuxGPUHost display-agent)", output);
+      else if (r == -EBUSY)
+         mlg_error("MLG_WSI_OUTPUT=%s: another process shows its frames there", output);
+      else
+         mlg_error("attaching to the display output failed: %s", strerror(-r));
+      goto fail_card;
+   }
+   attached = true;
+   chain->output = st;
+
+   /* Modifiers both planes scan out, else the primary plane's. */
+   nmods = mlg_plane_modifiers(chain->card, st.primary_plane_id, mods, 0, ARRAY_SIZE(mods), false);
+   if (st.overlay_plane_id) {
+      uint64_t both[ARRAY_SIZE(mods)];
+      memcpy(both, mods, nmods * sizeof(mods[0]));
+      uint32_t nboth = mlg_plane_modifiers(chain->card, st.overlay_plane_id, both, nmods,
+                                           ARRAY_SIZE(both), true);
+      if (nboth) {
+         memcpy(mods, both, nboth * sizeof(mods[0]));
+         nmods = nboth;
+      }
+   }
+   if (!nmods) {
+      mlg_error("%s's primary plane lists no XRGB8888 modifier", st.connector);
+      goto fail_detach;
+   }
+
+   /* The monitor's macOS display, for the window's placement. */
+   r = drmMlgConnectorDisplay(chain->card, st.connector_id, &chain->display_id);
+   if (r == -ENOENT) {
+      fprintf(stderr, "mlg-wsi: no macOS display stands for %s; the frames go full screen there "
+              "and the window stays where it is\n", st.connector);
+      chain->display_id = 0;
+   } else if (r) {
+      mlg_error("finding the macOS display of %s failed: %s", st.connector, strerror(-r));
+      goto fail_detach;
+   }
+   chain->window = wsi_mlg_window_cache_create(surface->pLayer);
+   if (!chain->window) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_detach;
+   }
+   if (chain->display_id) {
+      struct wsi_mlg_window win;
+      char why[160];
+
+      wsi_mlg_window_get(chain->window, &win);
+      if (win.has_window && win.display_id != chain->display_id) {
+         r = wsi_mlg_window_move(chain->window, chain->display_id, why, sizeof(why));
+         if (r) {
+            mlg_error("moving the window to %s's display failed: %s", st.connector, why);
+            goto fail_window;
+         }
+         fprintf(stderr, "mlg-wsi: moved the window to %s's display\n", st.connector);
+      }
+   }
+
+   const uint64_t *mod_list = mods;
+   struct wsi_drm_image_params image_params = {
+      .base.image_type = WSI_IMAGE_TYPE_DRM,
+      .same_gpu = true,
+      .num_modifier_lists = wsi_device->supports_modifiers ? 1 : 0,
+      .num_modifiers = &nmods,
+      .modifiers = &mod_list,
+   };
+   result = wsi_swapchain_init(wsi_device, &chain->base, device, pCreateInfo, &image_params.base,
+                               pAllocator);
+   if (result != VK_SUCCESS)
+      goto fail_window;
+
+   chain->base.destroy = wsi_mlg_swapchain_destroy;
+   chain->base.get_wsi_image = wsi_mlg_get_wsi_image;
+   chain->base.acquire_next_image = wsi_mlg_acquire_next_image;
+   chain->base.release_images = wsi_mlg_release_images;
+   chain->base.queue_present = wsi_mlg_queue_present;
+   chain->base.wait_for_present = wsi_mlg_wait_for_present;
+   chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   chain->base.image_count = num_images;
+   chain->status = VK_SUCCESS;
+
+   uint32_t created = 0;
+   for (; created < num_images; created++) {
+      result = mlg_image_init(chain, &chain->images[created]);
+      if (result != VK_SUCCESS) {
+         mlg_image_finish(chain, &chain->images[created]);
+         goto fail_images;
+      }
+   }
+
+   /* The driver's check of the first frame where it will go (and of
+    * the whole screen: a window may go full screen later). */
+   {
+      struct drm_mlg_placement place, whole = {
+         .layer = MLG_LX_LAYER_PRIMARY, .src_w = chain->extent.width,
+         .src_h = chain->extent.height, .dst_w = chain->output.width,
+         .dst_h = chain->output.height,
+      };
+
+      r = mlg_placement(chain, &place);
+      if (r) {
+         mlg_error("placing frames on %s: %s", chain->output.connector, place.why);
+         result = VK_ERROR_INITIALIZATION_FAILED;
+         goto fail_images;
+      }
+      for (int pass = 0; pass < 2; pass++) {
+         const struct drm_mlg_placement *p = pass ? &whole : &place;
+
+         if (!p->layer || (pass && mlg_same_placement(&place, &whole)))
+            continue;
+         r = mlg_scanout_image(chain, MLG_LX_SCANOUT_TEST, &chain->images[0], p, &st);
+         if (r) {
+            mlg_report_refusal(chain, "a swapchain image (modifier check)", p, r);
+            result = VK_ERROR_INITIALIZATION_FAILED;
+            goto fail_images;
+         }
+      }
+      chain->last = place;
+   }
+   fprintf(stderr, "mlg-wsi: %u %ux%u images on %s (%ux%u, modifier 0x%llx)\n", num_images,
+           chain->extent.width, chain->extent.height, chain->output.connector,
+           chain->output.width, chain->output.height,
+           (unsigned long long)chain->images[0].base.drm_modifier);
+   *swapchain_out = &chain->base;
+   return VK_SUCCESS;
+
+fail_images:
+   while (created > 0)
+      mlg_image_finish(chain, &chain->images[--created]);
+   wsi_swapchain_finish(&chain->base);
+fail_window:
+   wsi_mlg_window_cache_destroy(chain->window);
+fail_detach:
+   if (attached)
+      mlg_detach(chain);
+fail_card:
+   close(chain->card);
+fail_lock:
+   mtx_destroy(&chain->lock);
+fail_free:
+   vk_free(pAllocator, chain);
+   return result;
+}
+
+#endif /* LIBDRM_MLG_SCANOUT */
