+
+/* ---- mac_linuxgpu: the window of a layer whose frames the GPU's display
+ * engine shows (wsi_common_metal.c): where its content is on which screen,
+ * and moving it to another screen. AppKit is read and changed on the main
+ * thread only; a swapchain used on another thread gets the state last read
+ * there. ---- */
+
+@interface WsiMlgWindowCache : NSObject {
+@public
+   CALayer *layer;          /* not retained: the application owns it for the surface's life */
+   struct wsi_mlg_window state;
+   bool refresh_queued;
+}
+@end
+
+@implementation WsiMlgWindowCache
+@end
+
+struct wsi_mlg_window_cache {
+   WsiMlgWindowCache *object;
+};
+
+static NSView *
+layer_view(CALayer *layer)
+{
+   for (CALayer *l = layer; l; l = l.superlayer) {
+      id delegate = l.delegate;
+      if ([delegate isKindOfClass:[NSView class]])
+         return (NSView *)delegate;
+   }
+   return nil;
+}
+
+static NSScreen *
+screen_with_id(uint32_t display_id)
+{
+   for (NSScreen *screen in [NSScreen screens]) {
+      NSNumber *number = screen.deviceDescription[@"NSScreenNumber"];
+      if (number && number.unsignedIntValue == display_id)
+         return screen;
+   }
+   return nil;
+}
+
+/* On the main thread. */
+static void
+window_read(CALayer *layer, struct wsi_mlg_window *out)
+{
+   memset(out, 0, sizeof(*out));
+   @autoreleasepool {
+      NSView *view = layer_view(layer);
+      NSWindow *window = view.window;
+      NSScreen *screen = window.screen;
+      NSArray<NSScreen *> *screens = [NSScreen screens];
+      if (!view || !window || !screen || !screens.count)
+         return;
+
+      NSNumber *number = screen.deviceDescription[@"NSScreenNumber"];
+      NSRect content = [window convertRectToScreen:[view convertRect:view.bounds toView:nil]];
+      /* AppKit's global space has its origin at the bottom left of the
+       * first screen; CoreGraphics' at its top left, y downwards. */
+      const CGFloat top = NSMaxY(screens[0].frame);
+
+      out->has_window = number != nil;
+      out->display_id = number.unsignedIntValue;
+      out->x = content.origin.x;
+      out->y = top - NSMaxY(content);
+      out->width = content.size.width;
+      out->height = content.size.height;
+      out->scale = screen.backingScaleFactor;
+      out->native_fullscreen = (window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+   }
+}
+
+bool
+wsi_mlg_display_bounds(uint32_t display_id, double *x, double *y, double *width, double *height)
+{
+   CGRect bounds = CGDisplayBounds(display_id);
+
+   if (CGRectIsEmpty(bounds))
+      return false;
+   *x = bounds.origin.x;
+   *y = bounds.origin.y;
+   *width = bounds.size.width;
+   *height = bounds.size.height;
+   return true;
+}
+
+static void
+cache_refresh(WsiMlgWindowCache *cache)
+{
+   struct wsi_mlg_window state;
+
+   window_read(cache->layer, &state);
+   @synchronized(cache) {
+      cache->state = state;
+      cache->refresh_queued = false;
+   }
+}
+
+struct wsi_mlg_window_cache *
+wsi_mlg_window_cache_create(const CAMetalLayer *metal_layer)
+{
+   struct wsi_mlg_window_cache *cache = calloc(1, sizeof(*cache));
+   if (!cache)
+      return NULL;
+   cache->object = [[WsiMlgWindowCache alloc] init];
+   cache->object->layer = (CALayer *)metal_layer;
+   WsiMlgWindowCache *object = cache->object;
+   if ([NSThread isMainThread])
+      cache_refresh(object);
+   else
+      dispatch_sync(dispatch_get_main_queue(), ^{ cache_refresh(object); });
+   return cache;
+}
+
+void
+wsi_mlg_window_cache_destroy(struct wsi_mlg_window_cache *cache)
+{
+   if (!cache)
+      return;
+   /* A queued refresh holds its own reference. */
+   @synchronized(cache->object) {
+      cache->object->layer = nil;
+   }
+   [cache->object release];
+   free(cache);
+}
+
+void
+wsi_mlg_window_get(struct wsi_mlg_window_cache *cache, struct wsi_mlg_window *out)
+{
+   WsiMlgWindowCache *object = cache->object;
+
+   if ([NSThread isMainThread]) {
+      cache_refresh(object);
+      *out = object->state;
+      return;
+   }
+   bool queue = false;
+   @synchronized(object) {
+      *out = object->state;
+      if (!object->refresh_queued && object->layer) {
+         object->refresh_queued = true;
+         queue = true;
+      }
+   }
+   if (queue) {
+      [object retain];
+      dispatch_async(dispatch_get_main_queue(), ^{
+         CALayer *layer;
+         @synchronized(object) {
+            layer = object->layer;
+         }
+         if (layer)
+            cache_refresh(object);
+         [object release];
+      });
+   }
+}
+
+/* On the main thread. */
+static int
+window_move(CALayer *layer, uint32_t display_id, char *why, size_t why_size)
+{
+   @autoreleasepool {
+      NSView *view = layer_view(layer);
+      NSWindow *window = view.window;
+      NSScreen *target = screen_with_id(display_id);
+
+      if (!window) {
+         snprintf(why, why_size, "the layer is in no window");
+         return -ENOENT;
+      }
+      if (!target) {
+         snprintf(why, why_size, "no screen is display %u", display_id);
+         return -ENODEV;
+      }
+      if (window.screen == target)
+         return 0;
+      if (window.styleMask & NSWindowStyleMaskFullScreen) {
+         snprintf(why, why_size, "the window is in native full screen on another display; "
+                  "leave full screen or start the application on that display");
+         return -EBUSY;
+      }
+
+      NSRect from = window.screen ? window.screen.frame : NSZeroRect;
+      NSRect to = target.frame;
+      NSRect frame = window.frame;
+      CGFloat dx = frame.origin.x - from.origin.x;
+      CGFloat dy = frame.origin.y - from.origin.y;
+      CGFloat w = MIN(frame.size.width, to.size.width);
+      CGFloat h = MIN(frame.size.height, to.size.height);
+      dx = MAX(0, MIN(dx, to.size.width - w));
+      dy = MAX(0, MIN(dy, to.size.height - h));
+      [window setFrame:NSMakeRect(to.origin.x + dx, to.origin.y + dy, w, h) display:YES];
+      if (window.screen != target) {
+         snprintf(why, why_size, "the window did not move to display %u", display_id);
+         return -EIO;
+      }
+      return 0;
+   }
+}
+
+int
+wsi_mlg_window_move(struct wsi_mlg_window_cache *cache, uint32_t display_id, char *why,
+                    size_t why_size)
+{
+   WsiMlgWindowCache *object = cache->object;
+   CALayer *layer = object->layer;
+
+   why[0] = 0;
+   if ([NSThread isMainThread]) {
+      int r = window_move(layer, display_id, why, why_size);
+      cache_refresh(object);
+      return r;
+   }
+   [object retain];
+   dispatch_async(dispatch_get_main_queue(), ^{
+      char reason[160];
+      CALayer *l;
+      @synchronized(object) {
+         l = object->layer;
+      }
+      if (l) {
+         if (window_move(l, display_id, reason, sizeof(reason)))
+            fprintf(stderr, "mlg-wsi: moving the window to display %u failed: %s\n",
+                    display_id, reason);
+         cache_refresh(object);
+      }
+      [object release];
+   });
+   return 0;
+}
