diff --git a/src/util/os_drm.h b/src/util/os_drm.h
index 0390ecd..9dfc6e8 100644
--- a/src/util/os_drm.h
+++ b/src/util/os_drm.h
@@ -15,12 +15,23 @@
 #endif
 
 #include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
 #include <errno.h>
+#include <fcntl.h>
 #include <xf86drm.h>
 
+/* A libdrm that defines LIBDRM_FILE_OPS (mac_linuxgpu's, over a driver
+ * that runs outside the kernel) hands out DRM files that the system calls
+ * cannot open by path, stat, map or issue requests on; it provides those
+ * operations instead. These wrappers pick the right ones. */
+
 static inline int
 drm_ioctl(int fd, uint32_t request, void *arg)
 {
+#ifdef LIBDRM_FILE_OPS
+   return drmIoctl(fd, request, arg) ? -errno : 0;
+#else
    int ret;
 
    do {
@@ -28,6 +39,51 @@ drm_ioctl(int fd, uint32_t request, void *arg)
    } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
 
    return ret ? -errno : 0;
+#endif
+}
+
+/* open(2) of a DRM node. */
+static inline int
+os_drm_open(const char *path, int flags)
+{
+#ifdef LIBDRM_FILE_OPS
+   return drmFileOpen(path, flags);
+#else
+   return open(path, flags);
+#endif
+}
+
+/* stat(2) of a DRM node. */
+static inline int
+os_drm_stat(const char *path, struct stat *st)
+{
+#ifdef LIBDRM_FILE_OPS
+   return drmFileStat(path, st);
+#else
+   return stat(path, st);
+#endif
+}
+
+/* mmap(2) of a DRM file. */
+static inline void *
+os_drm_mmap(void *addr, size_t length, int prot, int flags, int fd, off_t offset)
+{
+#ifdef LIBDRM_FILE_OPS
+   return drmFileMmap(addr, length, prot, flags, fd, offset);
+#else
+   return mmap(addr, length, prot, flags, fd, offset);
+#endif
+}
+
+/* munmap(2) of what os_drm_mmap mapped. */
+static inline int
+os_drm_munmap(void *addr, size_t length)
+{
+#ifdef LIBDRM_FILE_OPS
+   return drmFileMunmap(addr, length);
+#else
+   return munmap(addr, length);
+#endif
 }
 
 static inline int
