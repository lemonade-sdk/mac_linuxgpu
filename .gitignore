# Build outputs. build/ also holds the setup stamp (build/setup/) and the
# fetched linux-firmware files (build/firmware/); both are regenerated by
# scripts/bootstrap.sh.
/build/
/build-dk/
/build/setup/
/build/firmware/
DerivedData/
*.o
*.d
*.a
*.dylib
*.so
*.dSYM/
*.log
__.SYMDEF*

# Xcode per-user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
com.apple.DeveloperTools/

# Python
__pycache__/
*.pyc

# Editors and macOS
.DS_Store
.vscode/
.idea/

# Test fixtures captured from a card (tests/fixtures/local/README.md). Never
# committed: the VBIOS is AMD's copyrighted image and the repository is public.
/tests/fixtures/local/*
!/tests/fixtures/local/README.md
