<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Development (local ad-hoc / dev-team) signing variant. Adds
	    com.apple.developer.driverkit=true which is required for development
	    DriverKit builds that are not yet covered by a production provisioning
	    profile. The two driverkit keys below mirror the production entitlements.
	    Ported from mac_amdgpu/Development.entitlements.
	-->
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.allow-any-userclient-access</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.pci</key>
	<array>
		<dict>
			<key>IOPCIPrimaryMatch</key>
			<string>0xFFFFFFFF&amp;0x00000000</string>
		</dict>
	</array>
</dict>
</plist>
